# Shared key required to view /admin submissions.
# Change this before deploying anywhere public.
ADMIN_KEY=changeme

# Supabase project (Settings -> API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is server-only — never expose it to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same Supabase project, public client config for login/signup (Settings ->
# API -> Project URL / anon public key). Safe to expose in the browser —
# access is enforced by the RLS policies in supabase/migrations, not by
# keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (resend.com) — sends the "your preview is ready" email from
# /admin. Leave unset to skip email: the preview link still gets generated
# and shown in /admin for you to send manually.
RESEND_API_KEY=
# Must be a domain you've verified in Resend. Defaults to Resend's shared
# onboarding@resend.dev sender (fine for testing, not for real customers).
RESEND_FROM_EMAIL=

# Preview links (/preview/<slug>) default to a path on whatever domain
# this app is deployed at. Once you've registered a domain and pointed
# wildcard DNS (*.yourdomain.com) at this Vercel project, set this to make
# links true subdomains instead — e.g. PREVIEW_DOMAIN=webdevelopers.com
# turns https://.../preview/abc123 into https://abc123.webdevelopers.com.
NEXT_PUBLIC_PREVIEW_DOMAIN=
# Only needed if NEXT_PUBLIC_PREVIEW_DOMAIN is unset and Vercel's own
# VERCEL_URL env var isn't available (e.g. running locally with a domain
# already attached). Leave blank in normal deployment.
NEXT_PUBLIC_SITE_URL=

# WhatsApp click-to-chat button + widget (bottom-right on every page).
# Digits only, with country code, no "+" and no spaces — e.g. a US number
# +1 (555) 123-4567 becomes 15551234567. Leave unset and the button still
# renders but opens a placeholder number — set this before going live.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Powers the on-site AI chatbot (docs/website-knowledge.md is its only
# source of truth). Get a key at openrouter.ai/keys. Leave unset and the
# chat panel shows an error asking visitors to use WhatsApp instead — the
# WhatsApp button itself doesn't need this.
OPENROUTER_API_KEY=
# Optional — any model id from openrouter.ai/models. Defaults to a small,
# inexpensive Claude model suited to short FAQ answers.
OPENROUTER_MODEL=
